# 根仓只忽略根自有产物：子仓各自带 .gitignore
node_modules
.DS_Store
*.local
*.log
.idea
.vscode
.turbo/
.cache/
.worktrees/

# 根 workspace 产物
packages/*/dist/
packages/*/node_modules/

# 部署运行时配置（deploy/.env.example 是模板）
deploy/.env
deploy/env/*.local.env
deploy/observability/prometheus/metrics_token

# 本地工具
.local/
